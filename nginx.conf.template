server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # The JavaScript bundle is the bulk of what a visitor downloads; compressed it is
    # roughly a third of the size.
    gzip            on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary       on;
    gzip_proxied    any;
    gzip_types      text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # Build output under /static/ carries a content hash in its name, so a given
    # address never changes and can be cached for a year.
    location /static/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri =404;
    }

    location / {
        # The shell must be revalidated on every visit, or a deploy stays invisible
        # until a cached copy expires.
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # Nothing in the app is meant to be found through search; the public site is.
        add_header X-Robots-Tag "noindex, nofollow" always;
        # SPA fallback: any deep link resolves to the app shell rather than 404.
        try_files $uri /index.html;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html { }
}
